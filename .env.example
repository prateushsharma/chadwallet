# ── ChadWallet environment ──────────────────────────────────────────────
# The app runs fully in "mock mode" with NONE of these set, so you can demo
# the UI immediately. Add keys to switch on live data + real auth.

# Privy — sign in with Apple / Google (https://dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=

# BirdEye — live Solana prices, charts, holders, trades (https://birdeye.so/data-api)
# Server-side only; never exposed to the client.
BIRDEYE_API_KEY=

# Alchemy Solana RPC — for reading balances / sending swaps (https://www.alchemy.com/rpc-api)
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
